# Example configuration for /etc/jellyfin-hotcache/config.yml
#
# Jellyfin hot-cache configuration for nidhoggur.
#
# First run is dry-run only. Review reports before setting:
#   cache.dry_run: false

hotcache:
  enabled: true

#  cache_root: /mnt/hiwrite-media/jellyfin-cache
  cache_root: /mnt/cache/jellyfin-cache
  manifest: /mnt/cache/jellyfin-cache/manifest.json

  maintenance:
    # When true, each run restores all manifest-tracked cached files back
    # to their original media paths, removes cache-managed copies, saves the
    # updated manifest, sends a report, and exits before any new promotion.
    # Leave true to keep hotcache effectively disabled. Set false to re-enable.
    restore_all_files_and_disable: false

    # Safer default: do not restore files that Jellyfin reports as actively
    # streaming. They remain in the manifest and will be retried next run.
    skip_active_streams: true

    # Remove empty cache subdirectories after files are restored.
    remove_empty_cache_dirs: true

jellyfin:
  url: "http://127.0.0.1:8096"
  api_key: ""
  api_key_env: "JELLYFIN_API_KEY"

playback_reporting:
  # Playback-history backend. Supported values:
  #
  #   jellyfin_sqlite
  #       Stock/default Jellyfin SQLite. Reads core UserData for lifetime
  #       PlayCount + LastPlayedDate and BaseItems for media paths. This does
  #       not require the Playback Reporting plugin.
  #
  #   postgresql
  #       Jellyfin core PostgreSQL. Reads public.UserData and public.BaseItems
  #       first; falls back only to real Playback Reporting event tables.
  #
  #   playback_reporting_sqlite
  #       Legacy Playback Reporting plugin SQLite database. Counts playback
  #       event rows inside the hot window rather than lifetime PlayCount.
  #
  #   sqlite
  #       Backward-compatible alias for playback_reporting_sqlite.
  #
  # Core Jellyfin SQLite/PostgreSQL modes use lifetime PlayCount and require
  # LastPlayedDate to be within hot_window_days. Duplicate CustomDataKey rows
  # for one item/user are collapsed before household play counts are summed.
  #
  # PostgreSQL path resolution comes from BaseItems instead of /Items because
  # some migrated PostgreSQL installs can return "Cannot deserialize unknown
  # type" for those API calls.
  source: "jellyfin_sqlite"

  # Used by SQLite modes. Stock Jellyfin core SQLite normally lives here:
  database_path: "/var/lib/jellyfin/data/jellyfin.db"

  # For source: playback_reporting_sqlite (or legacy source: sqlite), use the
  # Playback Reporting plugin database instead:
  # database_path: "/var/lib/jellyfin/data/playback_reporting.db"

  postgresql:
    # Option A: DSN. If dsn is set, it is used instead of host/port/database.
    # dsn: "host=/var/run/postgresql dbname=jellyfin user=jellyfin"

    # Option B: explicit connection settings. Adjust these to match your server.
    host: "127.0.0.1"
    port: 5432
    database: "jellyfin_pg"
    user: "jellyfin_pg"

    # Used only when source is postgresql. Prefer a .pgpass file or
    # password_env instead of storing a password here.
    # password: ""
    # password_env: "JELLYFIN_PG_PASSWORD"
    sslmode: "disable"

cache:
  root: "/mnt/cache/jellyfin-cache"

  # Starting cache limit.
  # Supports: B, KB, MB, GB, TB, KiB, MiB, GiB, TiB
  max_cache_size: "75GB"

  # Do not promote if this much actual filesystem free space would not remain.
  minimum_free_cache_space: "5GB"

  # Shipped default is dry-run. Set false only after reviewing reports.
  dry_run: true

  enable_promotion: true

  # Keep demotion disabled until the manifest and symlink behavior are trusted.
  enable_demotion: false

  # File-level caching only.
  promotion_mode: "main_file_only"
  allow_directory_promotion: false

  # If directory promotion is ever enabled in future code, reject large directories.
  max_directory_promotion_size: "15GB"

  # A 29GB Blu-ray MKV can still be cached with this setting.
  max_single_file_promotion_size: "35GB"

  # Prevent one file from consuming too much of the configured cache.
  max_single_file_percent_of_cache: 40

  hot_window_days: 30

  # Kids content is intentionally more aggressive because rewatches are common.
  promote_after_plays_movies: 3
  promote_after_plays_kids_movies: 2
  promote_after_plays_shows: 3
  promote_after_plays_kids_tv: 2

  # Music defaults: cache frequently played songs. With Jellyfin PostgreSQL
  # UserData, PlayCount is lifetime, while LastPlayedDate is windowed below.
  # So this means: at least 5 lifetime plays and last played within 30 days.
  promote_after_plays_music: 5

  # Reserve up to 5GB of the total cache for music. Video promotion is capped
  # at max_cache_size - reserve_for_music so music has room available.
  music:
    enabled: true
    max_cache_size: "5GB"
    reserve_for_music: "5GB"

  demote_after_days_unwatched: 90

  verify_copy: true
  use_absolute_symlinks: true
  skip_if_active_stream: true
  # Preserve the NAS-resident original by renaming it out of Jellyfin's
  # normal media extension path, then creating the Jellyfin-visible media
  # filename as a symlink to the HIWRITE cache copy. Example:
  #   Movie (2020).mkv        -> symlink to HIWRITE cache
  #   Movie (2020).mkv.cached -> preserved original on NEST
  preserve_original_on_source: true
  preserved_original_suffix: ".cached"
  keep_original_until_verified: true

media_selection:
  video_extensions:
    - ".mkv"
    - ".mp4"
    - ".m4v"
    - ".avi"
    - ".mov"
    - ".ts"
    - ".m2ts"
    - ".webm"

  audio_extensions:
    - ".mp3"
    - ".flac"
    - ".m4a"
    - ".aac"
    - ".ogg"
    - ".opus"
    - ".wav"
    - ".wma"
    - ".alac"
    - ".aiff"
    - ".ape"

  ignore_dirs:
    - "@eaDir"
    - "Extras"
    - "extras"
    - "Featurettes"
    - "featurettes"
    - "Behind The Scenes"
    - "behind the scenes"
    - "Trailers"
    - "trailers"
    - "Sample"
    - "sample"

  movie_main_file_strategy: "largest_video_file"
  show_main_file_strategy: "exact_item_path_from_jellyfin"

libraries:
  movies:
    - name: "Movies"
      source: "/mnt/nest/videos/Movies"
      cache_subdir: "movies/Movies"

    - name: "Kids Movies"
      source: "/mnt/nest/videos/Kids"
      cache_subdir: "movies/Kids"

  shows:
    - name: "Shows"
      source: "/mnt/nest/videos/Television Shows/Adults"
      cache_subdir: "shows/Adults"

    - name: "KidsTV"
      source: "/mnt/nest/videos/Television Shows/Kids"
      cache_subdir: "shows/Kids"

  music:
    # Configure each Jellyfin music library/root here. Multiple music libraries
    # are fine; the script matches candidates by filesystem path. Avoid
    # overlapping roots where possible. If they overlap, put the more specific
    # path first.
    - name: "Music FLAC"
      source: "/mnt/nest/music/flac"
      cache_subdir: "music/flac"
      promote_after_plays: 5

    - name: "Music V2"
      source: "/mnt/nest/music/V2"
      cache_subdir: "music/V2"
      promote_after_plays: 5

    # Example second music library. Uncomment and adjust if needed.
    # - name: "Music Other"
    #   source: "/mnt/nest/music/other"
    #   cache_subdir: "music/other"
    #   promote_after_plays: 5

reporting:
  enabled: true
  mode: "email"

  # Send even if there were no changes. Useful while testing.
  send_empty_report: true

  recipient: "alan@argentwolf.org"
  sender: "jellyfin-hotcache@nidhoggur.argentwolf.org"
  subject_prefix: "[Jellyfin Hot Cache]"

  report_dir: "/mnt/cache/jellyfin-cache/reports"

  # Assumes local mail works through postfix/sendmail.
  sendmail_path: "/usr/sbin/sendmail"
