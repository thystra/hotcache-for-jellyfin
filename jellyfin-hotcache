VIDEO_DEFAULTS = {
    ".mkv", ".mp4", ".m4v", ".avi", ".mov", ".ts", ".m2ts", ".webm"
}

AUDIO_DEFAULTS = {
    ".mp3", ".flac", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".wma", ".alac", ".aiff", ".ape"
}

VIDEO_KINDS = {"movie", "show"}
MUSIC_KINDS = {"music"}


