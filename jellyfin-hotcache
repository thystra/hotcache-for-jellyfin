    return []


def can_promote_file(
    source_file: Path,
    cache_file: Path,
    cache_root: Path,
    max_cache_size: int,
    min_free_space: int,
    max_single_file_size: int,
    max_single_file_percent: int,
    active_paths: set[str],
    config: dict[str, Any],
    candidate: Optional[Candidate] = None,
    manifest: Optional[dict[str, Any]] = None,
    projected_music_used: int = 0,
    projected_video_used: int = 0,
) -> tuple[bool, str]:
    source_identity = str(logical_path(source_file))

    if source_identity in active_paths:
        return False, "file is currently being streamed"

    if not source_file.exists():
        return False, "source file does not exist"

    if source_file.is_symlink():
        return False, "source file is already a symlink"

    if not source_file.is_file():
        return False, "source path is not a regular file"

    if cache_file.exists():
        return False, "cache destination already exists"

    preserved_original = original_sidecar_path(source_file, config)
    if preserved_original.exists() or preserved_original.is_symlink():
        return False, f"preserved original sidecar already exists: {preserved_original}"

    if not is_within_physical(cache_file.parent, cache_root):
        return False, "cache destination is outside cache root"

    file_size = source_file.stat().st_size

    if file_size > max_single_file_size:
        return False, f"file exceeds max_single_file_promotion_size: {human_size(file_size)}"

    if file_size > max_cache_size * (max_single_file_percent / 100):
        return False, f"file exceeds max_single_file_percent_of_cache: {human_size(file_size)}"

    used = directory_size(cache_root)
    if used + file_size > max_cache_size:
        return False, (
            f"cache limit exceeded: used {human_size(used)}, "
            f"file {human_size(file_size)}, limit {human_size(max_cache_size)}"
        )

    if candidate is not None:
        group = media_group_for_library(candidate.library)
        if group == "music":
            music_limit = get_music_cache_limit(config)
            if projected_music_used + file_size > music_limit:
                return False, (
                    f"music cache limit exceeded: projected music used {human_size(projected_music_used)}, "
                    f"file {human_size(file_size)}, music limit {human_size(music_limit)}"
                )
        else:
            video_limit = get_video_effective_limit(config, max_cache_size)
            if projected_video_used + file_size > video_limit:
                return False, (
                    f"video cache limit exceeded after reserving music space: "
                    f"projected video used {human_size(projected_video_used)}, "
                    f"file {human_size(file_size)}, video limit {human_size(video_limit)}"
                )

    usage = shutil.disk_usage(cache_root)
    if usage.free - file_size < min_free_space:
        return False, (
            f"filesystem free-space floor exceeded: free {human_size(usage.free)}, "
            f"file {human_size(file_size)}, required reserve {human_size(min_free_space)}"
        )

    return True, "ok"


def promote_file(
    candidate: Candidate,
    cache_file: Path,
    dry_run: bool,
    manifest: dict[str, Any],
    config: dict[str, Any],
) -> Action:
    source_file = candidate.source_file
    size = source_file.stat().st_size

    if dry_run:
        return Action(
            status="DRY-RUN PROMOTE",
            title=candidate.title,
            source=str(source_file),
            cache=str(cache_file),
            size_bytes=size,
            reason=candidate.reason,
        )

    mkdir_group_safe(cache_file.parent)

    temp_cache = cache_file.with_name(cache_file.name + ".tmp")
    preserved_original = original_sidecar_path(source_file, config)

    try:
        shutil.copy2(source_file, temp_cache)

        if source_file.stat().st_size != temp_cache.stat().st_size:
            temp_cache.unlink(missing_ok=True)
            raise RuntimeError(f"copy verification failed for {source_file}")

        os.replace(temp_cache, cache_file)
        set_group_permissions(cache_file)

        source_file.rename(preserved_original)
        os.symlink(str(cache_file), str(source_file))

        if not source_file.is_symlink():
            raise RuntimeError(f"symlink creation failed for {source_file}")

        if source_file.stat().st_size != cache_file.stat().st_size:
            source_file.unlink(missing_ok=True)
            preserved_original.rename(source_file)
            cache_file.unlink(missing_ok=True)
            raise RuntimeError(f"symlink verification failed for {source_file}")

        manifest.setdefault("items", {})[str(source_file)] = {
            "title": candidate.title,
            "item_id": candidate.item_id,
            "library": candidate.library.name,
            "kind": candidate.library.kind,
            "media_group": media_group_for_library(candidate.library),
            "source": str(source_file),
            "cache": str(cache_file),
            "preserved_original": str(preserved_original),
            "preserve_original_on_nas": True,
            "size_bytes": size,
            "promoted_at": now_iso(),
            "last_seen_hot": now_iso(),
            "plays_at_promotion": candidate.plays,
            "last_played": candidate.last_played,
        }

        return Action(
            status="PROMOTED",
            title=candidate.title,
            source=str(source_file),
            cache=str(cache_file),
            size_bytes=size,
            reason=candidate.reason,
        )

    except Exception:
        temp_cache.unlink(missing_ok=True)
        if source_file.is_symlink():
            source_file.unlink(missing_ok=True)
        if preserved_original.exists() and not source_file.exists():
            preserved_original.rename(source_file)
        cache_file.unlink(missing_ok=True)
        raise


def demote_cold_files(
    config: dict[str, Any],
    manifest: dict[str, Any],
    active_paths: set[str],
    dry_run: bool,
) -> list[Action]:
    cache_cfg = config["cache"]
    if not cache_cfg.get("enable_demotion", False):
        return []

    demote_after_days = int(cache_cfg.get("demote_after_days_unwatched", 90))
    cutoff = dt.datetime.now(dt.timezone.utc).astimezone() - dt.timedelta(days=demote_after_days)

    actions: list[Action] = []
    items = manifest.setdefault("items", {})

    for source_str, entry in list(items.items()):
        source = Path(source_str)
        cache = Path(entry["cache"])
        title = entry.get("title", source.name)
        size = int(entry.get("size_bytes", 0))

        promoted_at_text = entry.get("promoted_at")
        last_seen_hot_text = entry.get("last_seen_hot") or promoted_at_text
        try:
            last_seen_hot = dt.datetime.fromisoformat(last_seen_hot_text)
        except Exception:
            last_seen_hot = dt.datetime.now(dt.timezone.utc).astimezone()

        if last_seen_hot > cutoff:
            continue

        source_identity = str(logical_path(source))

        if source_identity in active_paths:
            actions.append(Action(
                status="SKIPPED DEMOTE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason="file is currently being streamed",
            ))
            continue

        if dry_run:
            actions.append(Action(
                status="DRY-RUN DEMOTE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason=f"not hot for {demote_after_days} days",
            ))
            continue

        if not source.is_symlink():
            actions.append(Action(
                status="SKIPPED DEMOTE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason="source is no longer a symlink",
            ))
            continue

        if not cache.exists():
            actions.append(Action(
                status="SKIPPED DEMOTE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason="cache file missing",
            ))
            continue

        preserved_original = Path(entry.get("preserved_original") or original_sidecar_path(source, config))

        if preserved_original.exists() and not preserved_original.is_symlink():
            if preserved_original.stat().st_size != cache.stat().st_size:
                raise RuntimeError(f"preserved original size does not match cache for {source}")
            source.unlink()
            preserved_original.rename(source)
            set_group_permissions(source)
            cache.unlink()
        else:
            # Backward-compatible fallback for manifest entries created by the
            # older move/delete-original behavior.
            temp_restore = source.with_name(source.name + ".restore.tmp")
            shutil.copy2(cache, temp_restore)

            if temp_restore.stat().st_size != cache.stat().st_size:
                temp_restore.unlink(missing_ok=True)
                raise RuntimeError(f"demotion restore verification failed for {source}")

            source.unlink()
            os.replace(temp_restore, source)
            set_group_permissions(source)
            cache.unlink()

        cache_root = Path(cache_cfg["root"]).resolve()
        parent = cache.parent
        while parent != cache_root and is_within(parent, cache_root):
            try:
                parent.rmdir()
            except OSError:
                break
            parent = parent.parent

        items.pop(source_str, None)

        actions.append(Action(
            status="DEMOTED",
            title=title,
            source=str(source),
            cache=str(cache),
            size_bytes=size,
            reason=f"not hot for {demote_after_days} days",
        ))

    return actions



def restore_all_cached_files(
    config: dict[str, Any],
    manifest: dict[str, Any],
    active_paths: set[str],
    dry_run: bool,
) -> list[Action]:
    """
    Restore every manifest-tracked hotcache item and remove its cached copy.

    This is intentionally separate from normal demotion:
      - it ignores cache.enable_demotion
      - it ignores last_seen_hot age
      - it is controlled by hotcache.maintenance.restore_all_files_and_disable

    Safety behavior:
      - active streams are skipped by default
      - non-symlink originals are skipped unless they are clearly stale entries
      - missing cache files do not cause source symlinks to be removed
      - manifest entries are removed only after a successful restore or when the
        original is already a real file and the cache file is gone
    """
    cache_cfg = config["cache"]
    maintenance_cfg = config.get("hotcache", {}).get("maintenance", {})
    skip_active = bool(maintenance_cfg.get("skip_active_streams", cache_cfg.get("skip_if_active_stream", True)))
    remove_empty_dirs = bool(maintenance_cfg.get("remove_empty_cache_dirs", True))

    actions: list[Action] = []
    items = manifest.setdefault("items", {})
    cache_root = Path(cache_cfg["root"]).resolve()

    for source_str, entry in list(items.items()):
        source = Path(source_str)
        cache = Path(entry.get("cache", ""))
        title = entry.get("title", source.name)
        size = int(entry.get("size_bytes", 0))

        if not str(cache):
            actions.append(Action(
                status="SKIPPED RESTORE",
                title=title,
                source=str(source),
                cache="",
                size_bytes=size,
                reason="manifest entry has no cache path",
            ))
            continue

        source_identity = str(logical_path(source))

        if skip_active and source_identity in active_paths:
            actions.append(Action(
                status="SKIPPED RESTORE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason="file is currently being streamed",
            ))
            continue

        if dry_run:
            actions.append(Action(
                status="DRY-RUN RESTORE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason="restore_all_files_and_disable is enabled",
            ))
            continue

        if not cache.exists():
            if source.exists() and not source.is_symlink():
                items.pop(source_str, None)
                actions.append(Action(
                    status="REMOVED STALE MANIFEST ENTRY",
                    title=title,
                    source=str(source),
                    cache=str(cache),
                    size_bytes=size,
                    reason="cache file missing and source is already a regular file",
                ))
            else:
                actions.append(Action(
                    status="SKIPPED RESTORE",
                    title=title,
                    source=str(source),
                    cache=str(cache),
                    size_bytes=size,
                    reason="cache file missing; manual repair may be required",
                ))
            continue

        if source.exists() and not source.is_symlink():
            actions.append(Action(
                status="SKIPPED RESTORE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason="source exists and is not a hotcache symlink",
            ))
            continue

        if source.is_symlink():
            try:
                symlink_target = source.resolve()
            except FileNotFoundError:
                symlink_target = Path(os.readlink(source))
                if not symlink_target.is_absolute():
                    symlink_target = (source.parent / symlink_target).resolve()

            if symlink_target != cache.resolve():
                actions.append(Action(
                    status="SKIPPED RESTORE",
                    title=title,
                    source=str(source),
                    cache=str(cache),
                    size_bytes=size,
                    reason=f"source symlink target does not match manifest cache path: {symlink_target}",
                ))
                continue

        temp_restore = source.with_name(source.name + ".restore.tmp")
        temp_restore.unlink(missing_ok=True)
        preserved_original = Path(entry.get("preserved_original") or original_sidecar_path(source, config))

        try:
            source.parent.mkdir(parents=True, exist_ok=True)

            if source.exists() or source.is_symlink():
                source.unlink()

            if preserved_original.exists() and not preserved_original.is_symlink():
                if preserved_original.stat().st_size != cache.stat().st_size:
                    raise RuntimeError(f"preserved original size does not match cache for {source}")
                preserved_original.rename(source)
                set_group_permissions(source)
                cache.unlink()
            else:
                # Backward-compatible fallback for entries promoted by older
                # versions that removed the NAS original after verification.
                shutil.copy2(cache, temp_restore)

                if temp_restore.stat().st_size != cache.stat().st_size:
                    temp_restore.unlink(missing_ok=True)
                    raise RuntimeError(f"restore verification failed for {source}")

                os.replace(temp_restore, source)
                set_group_permissions(source)
                cache.unlink()

            if remove_empty_dirs:
                parent = cache.parent
                while parent != cache_root and is_within(parent, cache_root):
                    try:
                        parent.rmdir()
                    except OSError:
                        break
                    parent = parent.parent

            items.pop(source_str, None)

            actions.append(Action(
                status="RESTORED",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason="restore_all_files_and_disable is enabled",
            ))
        except Exception as exc:
            temp_restore.unlink(missing_ok=True)
            actions.append(Action(
                status="FAILED RESTORE",
                title=title,
                source=str(source),
                cache=str(cache),
                size_bytes=size,
                reason=str(exc),
            ))

    return actions

def build_libraries(config: dict[str, Any]) -> list[Library]:
    cache_cfg = config["cache"]

    promote_movies = int(cache_cfg.get("promote_after_plays_movies", 2))
    promote_kids_movies = int(cache_cfg.get("promote_after_plays_kids_movies", 1))
    promote_shows = int(cache_cfg.get("promote_after_plays_shows", 1))
    promote_kids_tv = int(cache_cfg.get("promote_after_plays_kids_tv", 1))
    promote_music = int(cache_cfg.get("promote_after_plays_music", 5))

    libraries: list[Library] = []

    for entry in config.get("libraries", {}).get("movies", []):
        name = entry["name"]
        promote = promote_kids_movies if "kid" in name.lower() else promote_movies
        libraries.append(
            Library(
                name=name,
                kind="movie",
                source=Path(entry["source"]),
                cache_subdir=Path(entry["cache_subdir"]),
                promote_after_plays=promote,
            )
        )

    for entry in config.get("libraries", {}).get("shows", []):
        name = entry["name"]
        promote = promote_kids_tv if "kid" in name.lower() else promote_shows
        libraries.append(
            Library(
                name=name,
                kind="show",
                source=Path(entry["source"]),
                cache_subdir=Path(entry["cache_subdir"]),
                promote_after_plays=promote,
            )
        )

    for entry in config.get("libraries", {}).get("music", []):
        name = entry["name"]
        promote = int(entry.get("promote_after_plays", promote_music))
        libraries.append(
            Library(
                name=name,
                kind="music",
                source=Path(entry["source"]),
                cache_subdir=Path(entry["cache_subdir"]),
                promote_after_plays=promote,
            )
        )

    return libraries


def format_action(action: Action) -> str:
    lines = [
        f"  - {action.title}",
        f"    Status: {action.status}",
        f"    Source: {action.source}",
    ]
    if action.cache:
        lines.append(f"    Cache:  {action.cache}")
    lines.append(f"    Size:   {human_size(action.size_bytes)}")
    if action.reason:
        lines.append(f"    Reason: {action.reason}")
    return "\n".join(lines)


def build_report_text(config: dict[str, Any], report: RunReport) -> str:
    cache_root = config["cache"]["root"]
    projected_total = report.projected_cache_used or report.cache_used_after
    music_limit = get_music_cache_limit(config)
    video_limit = get_video_effective_limit(config, report.cache_limit)
    lines = [
        f"Jellyfin Hot Cache Report - {report.started_at}",
        "",
        "Cache status:",
        f"  Cache path:         {cache_root}",
        f"  Configured limit:   {human_size(report.cache_limit)}",
        f"  Used before:        {human_size(report.cache_used_before)}",
        f"  Used after:         {human_size(report.cache_used_after)}",
        f"  Projected used:     {human_size(projected_total)}",
        f"  Remaining allowed:  {human_size(max(report.cache_limit - projected_total, 0))}",
        f"  Music limit:        {human_size(music_limit)}",
        f"  Music projected:    {human_size(report.projected_music_used)}",
        f"  Music remaining:    {human_size(max(music_limit - report.projected_music_used, 0))}",
        f"  Video limit:        {human_size(video_limit)}",
        f"  Video projected:    {human_size(report.projected_video_used)}",
        f"  Video remaining:    {human_size(max(video_limit - report.projected_video_used, 0))}",
        f"  Filesystem free:    {human_size(report.filesystem_free)}",
        f"  Dry run:            {report.dry_run}",
        "",
    ]

    sections = [
        ("Promoted", report.promoted),
        ("Demoted", report.demoted),
        ("Restored", report.restored),
        ("Skipped", report.skipped),
        ("Candidates", report.candidates),
    ]

    for title, actions in sections:
        lines.append(f"{title}:")
        if not actions:
            lines.append("  - None")
        else:
            for action in actions:
                lines.append(format_action(action))
        lines.append("")

    if report.errors:
        lines.append("Errors:")
        for err in report.errors:
            lines.append(f"  - {err}")
        lines.append("")

    return "\n".join(lines)


def send_report(config: dict[str, Any], body: str, started_at: str) -> None:
    reporting = config.get("reporting", {})
    if not reporting.get("enabled", False):
        return

    report_dir = Path(reporting.get("report_dir", "/var/log/jellyfin-hotcache"))
    mkdir_group_safe(report_dir)
    report_file = report_dir / f"jellyfin-hotcache-{started_at[:10]}.txt"
    report_file.write_text(body, encoding="utf-8")

    if reporting.get("mode", "email") != "email":
        return

    send_empty = bool(reporting.get("send_empty_report", True))
    if not send_empty:
        if all(marker in body for marker in ["Promoted:\n  - None", "Demoted:\n  - None", "Restored:\n  - None", "Skipped:\n  - None"]):
            return

    msg = EmailMessage()
    sender = reporting["sender"]
    recipient = reporting["recipient"]
    subject_prefix = reporting.get("subject_prefix", "[Jellyfin Hot Cache]")
    msg["From"] = sender
    msg["To"] = recipient
    msg["Subject"] = f"{subject_prefix} Daily Report {started_at[:10]}"
    msg.set_content(body)

    sendmail_path = reporting.get("sendmail_path", "/usr/sbin/sendmail")
    proc = subprocess.run(
        [sendmail_path, "-t"],
        input=msg.as_bytes(),
        check=False,
    )

    if proc.returncode != 0:
        raise RuntimeError(f"sendmail failed with exit code {proc.returncode}")


def finish_run(
    config: dict[str, Any],
    report: RunReport,
    started_at: str,
    no_email: bool,
) -> int:
    """Print/save/send the run report and return a stable process exit code."""
    body = build_report_text(config, report)
    print(body)

    email_failed = False
    if not no_email:
        try:
            send_report(config, body, started_at)
        except Exception as exc:
            email_failed = True
            print(f"WARNING: report email failed: {exc}", file=sys.stderr)

    if report.errors:
        return 1
    if email_failed:
        return 2
    return 0


def acquire_run_lock(config: dict[str, Any]):
    """Acquire a non-blocking process lock and hold it for the caller's lifetime."""
    hotcache_cfg = config.get("hotcache", {}) or {}
    lock_path = Path(hotcache_cfg.get("lock_file", "/run/lock/jellyfin-hotcache.lock"))
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_fh = lock_path.open("a+", encoding="utf-8")
    try:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        lock_fh.close()
        raise RuntimeError(f"another jellyfin-hotcache run is already active: {lock_path}") from exc
    return lock_fh


def _check_result(results: list[CheckResult], status: str, name: str, detail: str) -> None:
    results.append(CheckResult(status=status, name=name, detail=detail))


def _check_lock_readonly(config: dict[str, Any], results: list[CheckResult]) -> None:
    hotcache_cfg = config.get("hotcache", {}) or {}
    lock_path = Path(hotcache_cfg.get("lock_file", "/run/lock/jellyfin-hotcache.lock"))

    if not lock_path.exists():
        parent = lock_path.parent
        if parent.exists() and os.access(parent, os.W_OK | os.X_OK):
            _check_result(results, "PASS", "run lock", f"available; lock file absent: {lock_path}")
        else:
            _check_result(results, "FAIL", "run lock", f"lock directory is not writable: {parent}")
        return

    try:
        with lock_path.open("r+") as fh:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                _check_result(results, "FAIL", "run lock", f"another run holds {lock_path}")
                return
            finally:
                try:
                    fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
                except OSError:
                    pass
        _check_result(results, "PASS", "run lock", f"available: {lock_path}")
    except OSError as exc:
        _check_result(results, "FAIL", "run lock", f"cannot inspect {lock_path}: {exc}")


def _check_postgresql_readonly(config: dict[str, Any], results: list[CheckResult]) -> None:
    playback = config.get("playback_reporting", {}) or {}
    conn = None
    try:
        conn, driver = _connect_postgresql(playback)
        cur = conn.cursor()
        cur.execute("SELECT current_database(), current_user")
        database, user = cur.fetchone()
        _check_result(results, "PASS", "PostgreSQL connection", f"{database} as {user} via {driver}")

        required = {
            "UserData": {"itemid", "userid", "playcount", "lastplayeddate"},
            "BaseItems": {"id", "path"},
        }
        for table_name, required_columns in required.items():
            cur.execute(
                """
                SELECT column_name
                FROM information_schema.columns
                WHERE table_schema = 'public' AND lower(table_name) = lower(%s)
                """,
                (table_name,),
            )
            columns = {str(row[0]).lower() for row in cur.fetchall()}
            missing = sorted(required_columns - columns)
            if missing:
                _check_result(
                    results,
                    "FAIL",
                    f"PostgreSQL {table_name} schema",
                    "missing columns: " + ", ".join(missing),
                )
            else:
                _check_result(results, "PASS", f"PostgreSQL {table_name} schema", "compatible")
    except Exception as exc:
        _check_result(results, "FAIL", "PostgreSQL connection", str(exc))
    finally:
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass


def _check_sqlite_readonly(config: dict[str, Any], results: list[CheckResult]) -> None:
    playback = config.get("playback_reporting", {}) or {}
    db_path = Path(
        playback.get(
            "database_path",
            "/var/lib/jellyfin/data/playback_reporting.db",
        )
    )
    if not db_path.exists():
        _check_result(results, "FAIL", "SQLite playback database", f"not found: {db_path}")
        return
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        try:
            rows = con.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()
        finally:
            con.close()
        _check_result(results, "PASS", "SQLite playback database", f"readable; {len(rows)} tables")
    except Exception as exc:
        _check_result(results, "FAIL", "SQLite playback database", str(exc))


def _check_jellyfin_sqlite_readonly(
    config: dict[str, Any],
    results: list[CheckResult],
) -> None:
    playback = config.get("playback_reporting", {}) or {}
    db_path = Path(
        playback.get("database_path", "/var/lib/jellyfin/data/jellyfin.db")
    )
    try:
        schema = inspect_jellyfin_sqlite_schema(db_path)
        _check_result(
            results,
            "PASS",
            "Jellyfin SQLite schema",
            (
                f"compatible: {schema['userdata_table']} + "
                f"{schema['baseitems_table']} in {db_path}"
            ),
        )
    except Exception as exc:
        _check_result(results, "FAIL", "Jellyfin SQLite schema", str(exc))


def _symlink_target(path: Path) -> Path:
    target = Path(os.readlink(path))
    if not target.is_absolute():
        target = path.parent / target
    return target.resolve(strict=False)


def run_preflight(config: dict[str, Any]) -> int:
    """Run read-only operational checks. Never create, repair, or rewrite state."""
    results: list[CheckResult] = []

    if bool(config.get("hotcache", {}).get("enabled", True)):
        _check_result(results, "PASS", "configuration", "valid; hotcache enabled")
    else:
        _check_result(results, "WARN", "configuration", "valid; hotcache.enabled=false")

    try:
        key = get_jellyfin_api_key(config)
        _check_result(results, "PASS", "Jellyfin API key", f"configured ({len(key)} characters)")
    except Exception as exc:
        _check_result(results, "FAIL", "Jellyfin API key", str(exc))
    else:
        try:
            active_paths = get_active_paths(config)
            _check_result(results, "PASS", "Jellyfin /Sessions", f"accessible; {len(active_paths)} active media paths")
        except Exception as exc:
            _check_result(results, "FAIL", "Jellyfin /Sessions", str(exc))

    source_mode = str(config.get("playback_reporting", {}).get("source", "sqlite")).lower()
    if source_mode in {"postgresql", "postgres", "pg"}:
        _check_result(results, "PASS", "playback source", "PostgreSQL")
        _check_postgresql_readonly(config, results)
    elif source_mode in {"jellyfin_sqlite", "core_sqlite", "jellyfin-core-sqlite"}:
        _check_result(results, "PASS", "playback source", "Jellyfin core SQLite")
        _check_jellyfin_sqlite_readonly(config, results)
    elif source_mode in {"sqlite", "playback_reporting_sqlite", "playback-reporting-sqlite"}:
        _check_result(results, "PASS", "playback source", "Playback Reporting SQLite")
        _check_sqlite_readonly(config, results)
    else:
        _check_result(results, "FAIL", "playback source", f"unsupported source: {source_mode}")

    try:
        libraries = build_libraries(config)
    except Exception as exc:
        libraries = []
        _check_result(results, "FAIL", "libraries", str(exc))

    for library in libraries:
        if not library.source.exists():
            _check_result(results, "FAIL", f"library {library.name}", f"not found: {library.source}")
        elif not library.source.is_dir():
            _check_result(results, "FAIL", f"library {library.name}", f"not a directory: {library.source}")
        elif not os.access(library.source, os.R_OK | os.X_OK):
            _check_result(results, "FAIL", f"library {library.name}", f"not readable: {library.source}")
        else:
            _check_result(results, "PASS", f"library {library.name}", str(library.source))

    cache_cfg = config["cache"]
    cache_root = Path(cache_cfg["root"])
    cache_available = False
    if not cache_root.exists():
        _check_result(results, "FAIL", "cache root", f"not found: {cache_root}")
    elif not cache_root.is_dir():
        _check_result(results, "FAIL", "cache root", f"not a directory: {cache_root}")
    elif not os.access(cache_root, os.R_OK | os.W_OK | os.X_OK):
        _check_result(results, "FAIL", "cache root", f"not readable/writable: {cache_root}")
    else:
        cache_available = True
        usage = shutil.disk_usage(cache_root)
        used = directory_size(cache_root)
        limit = parse_size(cache_cfg.get("max_cache_size", "50GB"))
        minimum_free = parse_size(cache_cfg.get("minimum_free_cache_space", "5GB"))
        _check_result(results, "PASS", "cache root", str(cache_root))
        if used > limit:
            _check_result(results, "FAIL", "cache limit", f"used {human_size(used)} exceeds limit {human_size(limit)}")
        else:
            _check_result(results, "PASS", "cache limit", f"used {human_size(used)} of {human_size(limit)}")
        if usage.free < minimum_free:
            _check_result(results, "FAIL", "cache free space", f"{human_size(usage.free)} free; requires {human_size(minimum_free)}")
        else:
            _check_result(results, "PASS", "cache free space", human_size(usage.free))

        try:
            cache_dev = cache_root.stat().st_dev
            for library in libraries:
                if library.source.exists() and library.source.stat().st_dev == cache_dev:
                    _check_result(
                        results,
                        "WARN",
                        f"filesystem {library.name}",
                        "library and cache report the same device; verify cache is on the intended filesystem",
                    )
        except OSError as exc:
            _check_result(results, "WARN", "filesystem identity", str(exc))

    _check_lock_readonly(config, results)

    manifest_path = cache_root / "manifest.json"
    manifest: dict[str, Any] = {"version": 1, "items": {}}
    if manifest_path.exists():
        try:
            manifest = load_manifest(manifest_path)
            items = manifest.get("items", {})
            if not isinstance(items, dict):
                raise RuntimeError("manifest.items is not an object")
            _check_result(results, "PASS", "manifest", f"{len(items)} entries: {manifest_path}")
        except Exception as exc:
            _check_result(results, "FAIL", "manifest", str(exc))
            items = {}
    else:
        items = {}
        _check_result(results, "WARN", "manifest", f"not present: {manifest_path}")

    tracked_cache_paths: set[str] = set()
    for source_str, entry in items.items():
        if not isinstance(entry, dict):
            _check_result(results, "FAIL", "manifest entry", f"non-object entry for {source_str}")
            continue
        source = Path(source_str)
        cache_value = str(entry.get("cache") or "")
        if not cache_value:
            _check_result(results, "FAIL", "manifest entry", f"missing cache path for {source}")
            continue
        cache = Path(cache_value)
        tracked_cache_paths.add(str(cache.resolve(strict=False)))

        library = find_matching_library(source, libraries)
        if library is None:
            _check_result(results, "FAIL", "manifest library", f"source is outside configured libraries: {source}")

        if cache_available and not is_within_physical(cache, cache_root):
            _check_result(results, "FAIL", "manifest cache path", f"outside cache root: {cache}")
            continue

        if source.is_symlink():
            target = _symlink_target(source)
            expected = cache.resolve(strict=False)
            if target != expected:
                _check_result(results, "FAIL", "cached symlink", f"{source} -> {target}; expected {expected}")
            elif not cache.exists():
                _check_result(results, "FAIL", "cached symlink", f"dangling cache target: {source} -> {cache}")
            else:
                _check_result(results, "PASS", "cached symlink", f"{source} -> {cache}")

            preserved = Path(entry.get("preserved_original") or original_sidecar_path(source, config))
            if not preserved.exists() or preserved.is_symlink():
                _check_result(results, "FAIL", "preserved original", f"missing regular file: {preserved}")
            elif cache.exists() and preserved.stat().st_size != cache.stat().st_size:
                _check_result(results, "FAIL", "preserved original", f"size mismatch: {preserved}")
            else:
                _check_result(results, "PASS", "preserved original", str(preserved))
        elif source.exists() and cache.exists():
            _check_result(results, "FAIL", "manifest state", f"source is regular but cache still exists: {source}")
        elif source.exists() and not cache.exists():
            _check_result(results, "WARN", "stale manifest entry", f"source already restored: {source}")
        elif not source.exists() and not source.is_symlink():
            _check_result(results, "FAIL", "manifest source", f"source missing: {source}")

    if cache_available:
        orphan_count = 0
        for root, dirs, files in os.walk(cache_root):
            root_path = Path(root)
            if root_path == cache_root:
                dirs[:] = [d for d in dirs if d != "reports"]
            for name in files:
                path = root_path / name
                if path == manifest_path or path.is_symlink():
                    continue
                if str(path.resolve(strict=False)) not in tracked_cache_paths:
                    orphan_count += 1
        if orphan_count:
            _check_result(results, "WARN", "orphan cache files", f"{orphan_count} untracked files")
        else:
            _check_result(results, "PASS", "orphan cache files", "0")

    print("Jellyfin Hotcache preflight")
    print()
    for result in results:
        print(f"{result.status:<5} {result.name:<28} {result.detail}")

    failures = sum(1 for result in results if result.status == "FAIL")
    warnings = sum(1 for result in results if result.status == "WARN")
    print()
    if failures:
        print(f"CHECK: FAIL ({failures} failures, {warnings} warnings)")
        return 1
    print(f"CHECK: PASS ({warnings} warnings)")
    return 0


def validate_config(config: dict[str, Any]) -> None:
    required = [
        ("cache", "root"),
        ("cache", "max_cache_size"),
        ("libraries",),
    ]

    for path in required:
        cursor: Any = config
        for key in path:
            if not isinstance(cursor, dict) or key not in cursor:
                raise RuntimeError(f"Missing required config key: {'.'.join(path)}")
            cursor = cursor[key]

    cache_cfg = config["cache"]
    if cache_cfg.get("allow_directory_promotion", False):
        raise RuntimeError(
            "allow_directory_promotion is true. This script is intentionally "
            "file-first; review code before enabling directory promotion."
        )

    if cache_cfg.get("promotion_mode", "main_file_only") != "main_file_only":
        raise RuntimeError("Only cache.promotion_mode=main_file_only is supported")

    if not cache_cfg.get("preserve_original_on_source", True):
        raise RuntimeError(
            "cache.preserve_original_on_source=false is unsupported; "
            "the current safety model requires preserving the NAS original"
        )

    if not cache_cfg.get("use_absolute_symlinks", True):
        raise RuntimeError(
            "cache.use_absolute_symlinks=false is unsupported by the current implementation"
        )


def main() -> int:
    parser = argparse.ArgumentParser(description="Jellyfin hot-cache manager")
    parser.add_argument(
        "--config",
        default="/etc/jellyfin-hotcache/config.yml",
        help="Path to YAML config file",
    )
    parser.add_argument(
        "--environment-file",
        default="/etc/jellyfin-hotcache/environment",
        help=(
            "Path to optional NAME=value environment file; existing process "
            "environment variables take precedence"
        ),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Run read-only preflight checks and exit",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Force dry-run regardless of config setting",
    )
    parser.add_argument(
        "--no-email",
        action="store_true",
        help="Do not send email report for this run",
    )
    args = parser.parse_args()

    config_path = Path(args.config)
    environment_path = Path(args.environment_file)
    try:
        load_environment_file(environment_path)
        config = load_config(config_path)
        validate_config(config)
    except Exception as exc:
        if args.check:
            print(f"FAIL  configuration                {exc}")
            print("\nCHECK: FAIL (configuration error)")
            return 2
        raise

    if args.check:
        return run_preflight(config)

    if not bool(config.get("hotcache", {}).get("enabled", True)):
        print("Jellyfin hotcache is disabled by hotcache.enabled=false")
        return 0

    run_lock = acquire_run_lock(config)

    started_at = now_iso()
    cache_cfg = config["cache"]
    cache_root = Path(cache_cfg["root"])

    if not cache_root.exists() or not cache_root.is_dir():
        raise RuntimeError(
            f"cache root is missing or is not a directory: {cache_root}; "
            "refusing to create it because the cache mount may be absent"
        )
    mkdir_group_safe(cache_root / "reports")

    dry_run = bool(cache_cfg.get("dry_run", True)) or args.dry_run

    max_cache_size = parse_size(cache_cfg.get("max_cache_size", "50GB"))
    min_free_space = parse_size(cache_cfg.get("minimum_free_cache_space", "5GB"))
    max_single_file_size = parse_size(cache_cfg.get("max_single_file_promotion_size", "35GB"))
    max_single_file_percent = int(cache_cfg.get("max_single_file_percent_of_cache", 75))

    manifest_path = cache_root / "manifest.json"
    manifest = load_manifest(manifest_path)

    initial_cache_used = directory_size(cache_root)
    report = RunReport(
        started_at=started_at,
        dry_run=dry_run,
        cache_used_before=initial_cache_used,
        cache_limit=max_cache_size,
        filesystem_free=shutil.disk_usage(cache_root).free,
        projected_cache_used=initial_cache_used,
        projected_music_used=manifest_group_size(manifest, "music"),
        projected_video_used=manifest_group_size(manifest, "video"),
    )

    maintenance_cfg = config.get("hotcache", {}).get("maintenance", {})
    restore_all_and_disable = bool(maintenance_cfg.get("restore_all_files_and_disable", False))

    if restore_all_and_disable:
        try:
            active_paths = set()
            if cache_cfg.get("skip_if_active_stream", True) or maintenance_cfg.get("skip_active_streams", True):
                active_paths = get_active_paths(config)

            restore_actions = restore_all_cached_files(config, manifest, active_paths, dry_run)
            for action in restore_actions:
                if action.status in {"RESTORED", "DRY-RUN RESTORE", "REMOVED STALE MANIFEST ENTRY"}:
                    report.restored.append(action)
                else:
                    report.skipped.append(action)

            report.cache_used_after = directory_size(cache_root)
            report.projected_cache_used = report.cache_used_after
            report.filesystem_free = shutil.disk_usage(cache_root).free

            if not dry_run:
                save_manifest(manifest_path, manifest)

        except Exception as exc:
            report.errors.append(f"Restore-all-and-disable failed: {exc}")

        return finish_run(config, report, started_at, args.no_email)

    try:
        libraries = build_libraries(config)
        media_cfg = config.get("media_selection", {})
        video_extensions = {e.lower() for e in media_cfg.get("video_extensions", VIDEO_DEFAULTS)}
        audio_extensions = {e.lower() for e in media_cfg.get("audio_extensions", AUDIO_DEFAULTS)}
        extensions = video_extensions | audio_extensions

        active_paths = set()
        if cache_cfg.get("skip_if_active_stream", True):
            try:
                active_paths = get_active_paths(config)
            except Exception as exc:
                raise RuntimeError(
                    "could not verify active Jellyfin streams; refusing a mutating run"
                ) from exc

        candidates: list[Candidate] = []
        if cache_cfg.get("enable_promotion", True):
            source_mode = config.get("playback_reporting", {}).get("source", "sqlite")
            try:
                if source_mode in {"sqlite", "playback_reporting_sqlite", "playback-reporting-sqlite"}:
                    candidates = query_playback_reporting_sqlite(config, libraries, extensions)
                elif source_mode in {"jellyfin_sqlite", "core_sqlite", "jellyfin-core-sqlite"}:
                    candidates = query_jellyfin_sqlite(config, libraries, extensions)
                elif source_mode in {"postgresql", "postgres", "pg"}:
                    candidates = query_playback_reporting_postgresql(config, libraries, extensions)
                else:
                    candidates = discover_recent_candidates_fallback(config, libraries, extensions)
            except Exception as exc:
                raise RuntimeError(
                    "could not query playback history; refusing a mutating run"
                ) from exc

        candidates = dedupe_candidates(candidates)

        hot_sources = {str(c.source_file): c for c in candidates}
        for source_str, entry in manifest.setdefault("items", {}).items():
            if source_str in hot_sources:
                entry["last_seen_hot"] = now_iso()
                entry["last_played"] = hot_sources[source_str].last_played

        projected_cache_used = report.projected_cache_used
        projected_music_used = report.projected_music_used
        projected_video_used = report.projected_video_used

        for candidate in candidates:
            cache_file = build_cache_path(cache_root, candidate)
            report.candidates.append(
                Action(
                    status="CANDIDATE",
                    title=candidate.title,
                    source=str(candidate.source_file),
                    cache=str(cache_file),
                    size_bytes=candidate.size_bytes,
                    reason=candidate.reason,
                )
            )

            ok, reason = can_promote_file(
                source_file=candidate.source_file,
                cache_file=cache_file,
                cache_root=cache_root,
                max_cache_size=max_cache_size,
                min_free_space=min_free_space,
                max_single_file_size=max_single_file_size,
                max_single_file_percent=max_single_file_percent,
                active_paths=active_paths,
                config=config,
                candidate=candidate,
                manifest=manifest,
                projected_music_used=projected_music_used,
                projected_video_used=projected_video_used,
            )

            if not ok:
                report.skipped.append(
                    Action(
                        status="SKIPPED PROMOTE",
                        title=candidate.title,
                        source=str(candidate.source_file),
                        cache=str(cache_file),
                        size_bytes=candidate.size_bytes,
                        reason=reason,
                    )
                )
                continue

            if projected_cache_used + candidate.size_bytes > max_cache_size:
                report.skipped.append(
                    Action(
                        status="SKIPPED PROMOTE",
                        title=candidate.title,
                        source=str(candidate.source_file),
                        cache=str(cache_file),
                        size_bytes=candidate.size_bytes,
                        reason=(
                            "projected cache limit exceeded: "
                            f"projected used {human_size(projected_cache_used)}, "
                            f"file {human_size(candidate.size_bytes)}, "
                            f"limit {human_size(max_cache_size)}"
                        ),
                    )
                )
                continue

            try:
                action = promote_file(candidate, cache_file, dry_run, manifest, config)
                report.promoted.append(action)
                projected_cache_used += candidate.size_bytes
                if media_group_for_library(candidate.library) == "music":
                    projected_music_used += candidate.size_bytes
                    report.projected_music_used = projected_music_used
                else:
                    projected_video_used += candidate.size_bytes
                    report.projected_video_used = projected_video_used
                report.projected_cache_used = projected_cache_used
            except Exception as exc:
                report.errors.append(f"Promotion failed for {candidate.source_file}: {exc}")
                report.skipped.append(
                    Action(
                        status="FAILED PROMOTE",
                        title=candidate.title,
                        source=str(candidate.source_file),
                        cache=str(cache_file),
                        size_bytes=candidate.size_bytes,
                        reason=str(exc),
                    )
                )

        try:
            demote_actions = demote_cold_files(config, manifest, active_paths, dry_run)
            for action in demote_actions:
                if action.status in {"DEMOTED", "DRY-RUN DEMOTE"}:
                    report.demoted.append(action)
                else:
                    report.skipped.append(action)
        except Exception as exc:
            report.errors.append(f"Demotion failed: {exc}")

        report.cache_used_after = directory_size(cache_root)
        if not report.projected_cache_used:
            report.projected_cache_used = report.cache_used_after
        report.filesystem_free = shutil.disk_usage(cache_root).free

        if not dry_run:
            save_manifest(manifest_path, manifest)

    except Exception as exc:
        report.errors.append(f"Run aborted: {exc}")

    report.cache_used_after = directory_size(cache_root)
    if not report.projected_cache_used:
        report.projected_cache_used = report.cache_used_after
    report.filesystem_free = shutil.disk_usage(cache_root).free

    return finish_run(config, report, started_at, args.no_email)


if __name__ == "__main__":
    raise SystemExit(main())
