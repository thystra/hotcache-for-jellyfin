def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).astimezone().isoformat(timespec="seconds")


def parse_size(value: str | int | float) -> int:
    if isinstance(value, (int, float)):
        return int(value)

    units = {
        "B": 1,
        "KB": 1000,
        "MB": 1000 ** 2,
        "GB": 1000 ** 3,
        "TB": 1000 ** 4,
        "KIB": 1024,
        "MIB": 1024 ** 2,
        "GIB": 1024 ** 3,
        "TIB": 1024 ** 4,
    }

    s = str(value).strip().upper().replace(" ", "")
    number = ""
    unit = ""

    for char in s:
        if char.isdigit() or char == ".":
            number += char
        else:
            unit += char

    if not unit:
        unit = "B"

    if not number or unit not in units:
        raise ValueError(f"Invalid size value: {value}")

    return int(float(number) * units[unit])


def human_size(num: int) -> str:
    """Format a byte count using explicit IEC binary units."""
    n = float(num)
    for unit in ["B", "KiB", "MiB", "GiB", "TiB", "PiB"]:
        if abs(n) < 1024 or unit == "PiB":
            if unit == "B":
                return f"{int(n)} B"
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{num} B"


def load_environment_file(path: Path) -> int:
    """
    Load simple NAME=value entries without overriding the process environment.

    The parser intentionally does not execute shell syntax or perform variable
    expansion. Blank lines and lines beginning with '#' or ';' are ignored,
    and a complete value may be wrapped in matching single or double quotes.
    """
    if not path.exists():
        return 0
    if not path.is_file():
        raise RuntimeError(f"Environment file is not a regular file: {path}")

    loaded = 0
    with path.open("r", encoding="utf-8") as fh:
        for line_number, raw_line in enumerate(fh, start=1):
            line = raw_line.strip()
            if not line or line.startswith(("#", ";")):
                continue
            if "=" not in line:
                raise RuntimeError(
                    f"Invalid environment file line {line_number} in {path}: expected NAME=value"
                )

            name, value = line.split("=", 1)
            name = name.strip()
            value = value.strip()

            if not name or not (name[0].isalpha() or name[0] == "_") or not all(
                char.isalnum() or char == "_" for char in name
            ):
                raise RuntimeError(
                    f"Invalid environment variable name on line {line_number} in {path}: {name!r}"
                )

            if value[:1] in {"'", '"'}:
                quote = value[0]
                if len(value) < 2 or value[-1] != quote:
                    raise RuntimeError(
                        f"Unterminated quoted value on line {line_number} in {path}"
                    )
                value = value[1:-1]

            if name not in os.environ:
                os.environ[name] = value
                loaded += 1

    return loaded


def load_config(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as fh:
        data = yaml.safe_load(fh)
    if not isinstance(data, dict):
        raise RuntimeError(f"Invalid config file: {path}")
    return data


def load_manifest(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {"version": 1, "items": {}}
    with path.open("r", encoding="utf-8") as fh:
        return json.load(fh)


def save_manifest(path: Path, manifest: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=path.name, suffix=".tmp", dir=str(path.parent))
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(manifest, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp_name, path)


def directory_size(path: Path) -> int:
    if not path.exists():
        return 0

    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            p = Path(root) / name
            try:
                if p.is_symlink():
                    continue
                total += p.stat().st_size
            except FileNotFoundError:
                continue
    return total


def manifest_group_size(manifest: dict[str, Any], group: str) -> int:
    """Return manifest-tracked cache usage for a media group such as music or video."""
    total = 0
    for entry in manifest.get("items", {}).values():
        if not isinstance(entry, dict):
            continue
        entry_group = str(entry.get("media_group") or "").lower()
        entry_kind = str(entry.get("kind") or "").lower()
        cache_path = str(entry.get("cache") or "").lower()

        if not entry_group:
            if entry_kind in MUSIC_KINDS or "/music/" in cache_path or cache_path.endswith("/music"):
                entry_group = "music"
            else:
                entry_group = "video"

        if entry_group != group:
            continue

        try:
            total += int(entry.get("size_bytes", 0))
        except Exception:
            continue
    return total


def media_group_for_library(library: Library) -> str:
    return "music" if library.kind in MUSIC_KINDS else "video"


def get_music_cache_limit(config: dict[str, Any], default: str = "5GB") -> int:
    cache_cfg = config.get("cache", {})
    music_cfg = cache_cfg.get("music", {}) or {}
    value = music_cfg.get("max_cache_size", cache_cfg.get("music_max_cache_size", default))
    return parse_size(value)


def get_video_effective_limit(config: dict[str, Any], max_cache_size: int) -> int:
    cache_cfg = config.get("cache", {})
    music_cfg = cache_cfg.get("music", {}) or {}
    reserve = music_cfg.get("reserve_for_music", cache_cfg.get("reserve_for_music", music_cfg.get("max_cache_size", "0B")))
    try:
        reserve_bytes = parse_size(reserve)
    except Exception:
        reserve_bytes = 0
    return max(max_cache_size - reserve_bytes, 0)


def is_video_file(path: Path, extensions: set[str]) -> bool:
    return path.is_file() and path.suffix.lower() in extensions


def logical_path(path: Path) -> Path:
    """Return an absolute normalized path without dereferencing symlinks."""
    return Path(os.path.abspath(os.fspath(path)))


def is_within(path: Path, parent: Path) -> bool:
    """Test logical pathname containment without following symlinks."""
    try:
        logical_path(path).relative_to(logical_path(parent))
        return True
    except ValueError:
        return False


def is_within_physical(path: Path, parent: Path) -> bool:
    """Test physical containment, following existing symlinks."""
    try:
        path.resolve(strict=False).relative_to(parent.resolve(strict=False))
        return True
    except ValueError:
        return False


def safe_relative_path(source_file: Path, library_root: Path) -> Path:
    try:
        return logical_path(source_file).relative_to(logical_path(library_root))
    except ValueError:
        raise RuntimeError(f"Source is outside configured library root: {source_file}")


def find_matching_library(source_file: Path, libraries: list[Library]) -> Optional[Library]:
    for library in libraries:
        if is_within(source_file, library.source):
            return library
    return None


def build_cache_path(cache_root: Path, candidate: Candidate) -> Path:
    rel = safe_relative_path(candidate.source_file, candidate.library.source)
    return cache_root / candidate.library.cache_subdir / rel


def original_sidecar_path(source_file: Path, config: dict[str, Any]) -> Path:
    """Return the NAS-resident preserved original path for a promoted media file."""
    suffix = str(config.get("cache", {}).get("preserved_original_suffix", ".cached"))
    if not suffix:
        suffix = ".cached"
    return source_file.with_name(source_file.name + suffix)


def dedupe_candidates(candidates: list[Candidate]) -> list[Candidate]:
    """
    De-duplicate by source file.

    Keep the strongest candidate for each file. This protects against duplicate
    Jellyfin/Playback Reporting rows, multiple users/devices, or repeated API
    resolution to the same underlying media path.
    """
    by_source: dict[str, Candidate] = {}

    for candidate in candidates:
        key = str(candidate.source_file)
        existing = by_source.get(key)

        if existing is None:
            by_source[key] = candidate
            continue

        if candidate.plays > existing.plays:
            by_source[key] = candidate
        elif candidate.plays == existing.plays and str(candidate.last_played or "") > str(existing.last_played or ""):
            by_source[key] = candidate

    return sorted(
        by_source.values(),
        key=lambda c: (c.plays, c.last_played or "", c.size_bytes),
        reverse=True,
    )


def mkdir_group_safe(path: Path, mode: int = 0o2775) -> None:
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, mode)
    except PermissionError:
        pass


def set_group_permissions(path: Path, file_mode: int = 0o664, dir_mode: int = 0o2775) -> None:
    if path.is_dir() and not path.is_symlink():
        try:
            os.chmod(path, dir_mode)
        except PermissionError:
            pass
    elif path.exists() and not path.is_symlink():
        try:
            os.chmod(path, file_mode)
        except PermissionError:
            pass


def get_jellyfin_api_key(config: dict[str, Any]) -> str:
    jellyfin_cfg = config.get("jellyfin", {}) or {}
    env_name = str(jellyfin_cfg.get("api_key_env") or "").strip()
    if env_name:
        value = os.environ.get(env_name, "").strip()
        if value:
            return value

    value = str(jellyfin_cfg.get("api_key") or "").strip()
    if value:
        return value

    if env_name:
        raise RuntimeError(f"Jellyfin API key environment variable is not set: {env_name}")
    raise RuntimeError("Jellyfin API key is not configured")


def jellyfin_get(config: dict[str, Any], endpoint: str, params: dict[str, Any] | None = None) -> Any:
    base_url = config["jellyfin"]["url"].rstrip("/")
    api_key = get_jellyfin_api_key(config)

    url = base_url + endpoint
    if params:
        url += "?" + urllib.parse.urlencode(params)

    request = urllib.request.Request(
        url,
        headers={
            "Authorization": (
                f'MediaBrowser Token="{api_key}", '
                'Client="jellyfin-hotcache", '
                'Device="server", '
                'DeviceId="jellyfin-hotcache", '
                'Version="1.0"'
            ),
            "Accept": "application/json",
        },
        method="GET",
    )

    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read().decode("utf-8")
            if not raw:
                return None
            return json.loads(raw)
    except urllib.error.HTTPError as exc:
        raise RuntimeError(f"Jellyfin API HTTP {exc.code} for {endpoint}: {exc.reason}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Jellyfin API error for {endpoint}: {exc}") from exc


def get_item_from_jellyfin(
    config: dict[str, Any],
    item_id: str,
    user_id: Optional[str] = None,
) -> Optional[dict[str, Any]]:
    """
    Resolve a Playback Reporting ItemId to a Jellyfin item.

    Jellyfin deployments differ on which item endpoint will expose Path with an
    API key. Try several safe read-only forms before giving up.
    """
    endpoints: list[tuple[str, dict[str, Any] | None]] = [
        (f"/Items/{item_id}", None),
        ("/Items", {"Ids": item_id, "Fields": "Path"}),
    ]

    if user_id:
        endpoints.insert(1, (f"/Users/{user_id}/Items/{item_id}", None))

    for endpoint, params in endpoints:
        try:
            data = jellyfin_get(config, endpoint, params=params)
        except Exception:
            continue

        if isinstance(data, dict):
            if data.get("Path") or data.get("Name") or data.get("Id"):
                return data
            items = data.get("Items")
            if isinstance(items, list) and items:
                first = items[0]
                if isinstance(first, dict):
                    return first

    return None


def get_active_paths(config: dict[str, Any]) -> set[str]:
    """Return logical media paths for active sessions. API failures are fatal."""
    active: set[str] = set()
    sessions = jellyfin_get(config, "/Sessions")

    if sessions is None:
        sessions = []
    if not isinstance(sessions, list):
        raise RuntimeError("Jellyfin /Sessions returned an unexpected response")

    for session in sessions:
        now_playing = session.get("NowPlayingItem") if isinstance(session, dict) else None
        if not isinstance(now_playing, dict):
            continue
        path = now_playing.get("Path")
        if path:
            active.add(str(logical_path(Path(path))))

    return active


def find_largest_video_file(directory: Path, ignore_dirs: set[str], extensions: set[str]) -> Optional[Path]:
    candidates: list[Path] = []

    for root, dirs, files in os.walk(directory):
        dirs[:] = [d for d in dirs if d not in ignore_dirs]
        for name in files:
            p = Path(root) / name
            try:
                if is_video_file(p, extensions):
                    candidates.append(p)
            except OSError:
                continue

    if not candidates:
        return None

    return max(candidates, key=lambda p: p.stat().st_size)


def query_playback_reporting_sqlite(
    config: dict[str, Any],
    libraries: list[Library],
    extensions: set[str],
) -> list[Candidate]:
    playback = config.get("playback_reporting", {})
    db_path = Path(
        playback.get("database_path", "/var/lib/jellyfin/data/playback_reporting.db")
    )
    if not db_path.exists():
        raise RuntimeError(f"Playback Reporting database not found: {db_path}")

    hot_window_days = int(config["cache"].get("hot_window_days", 30))
    cutoff = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=hot_window_days)
    cutoff_min = cutoff.strftime("%Y-%m-%d")

    con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row

    try:
        tables = [
            row["name"]
            for row in con.execute(
                "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
            )
        ]

        preferred_tables = [
            "PlaybackActivity",
            "PlaybackActivityEntry",
            "ActivityLog",
            "PlaybackReport",
        ]

        table = next((t for t in preferred_tables if t in tables), None)
        if table is None:
            for t in tables:
                cols = [r["name"] for r in con.execute(f'PRAGMA table_info("{t}")')]
                lower = {c.lower() for c in cols}
                if "itemid" in lower and any("date" in c for c in lower):
                    table = t
                    break

        if table is None:
            raise RuntimeError(
                f"Could not identify playback table in {db_path}; found tables: {tables}"
            )

        cols = [r["name"] for r in con.execute(f'PRAGMA table_info("{table}")')]
        lower_map = {c.lower(): c for c in cols}

        item_col = lower_map.get("itemid") or lower_map.get("item_id")
        name_col = (
            lower_map.get("itemname")
            or lower_map.get("name")
            or lower_map.get("item_name")
            or lower_map.get("title")
        )

        date_candidates = [
            "datecreated",
            "created",
            "playbackdate",
            "lastplayeddate",
            "date",
            "timestamp",
        ]
        date_col = next((lower_map[c] for c in date_candidates if c in lower_map), None)

        if not item_col:
            raise RuntimeError(f"Could not find ItemId column in table {table}")
        if not date_col:
            raise RuntimeError(f"Could not find date column in table {table}")

        user_col = lower_map.get("userid") or lower_map.get("user_id")
        user_expr = f'MAX("{user_col}")' if user_col else "NULL"
        title_expr = f'MAX("{name_col}")' if name_col else f'"{item_col}"'

        # Aggregate by ItemId only. Playback Reporting can contain separate rows
        # for different users/devices; grouping by user creates duplicate
        # candidates for the same media file.
        sql = f"""
            SELECT "{item_col}" AS item_id,
                   {user_expr} AS user_id,
                   {title_expr} AS title,
                   COUNT(*) AS plays,
                   MAX("{date_col}") AS last_played
            FROM "{table}"
            WHERE "{date_col}" >= ?
            GROUP BY "{item_col}"
            ORDER BY plays DESC, last_played DESC
        """

        rows = list(con.execute(sql, (cutoff_min,)))

    finally:
        con.close()

    candidates: list[Candidate] = []
    ignore_dirs = set(config.get("media_selection", {}).get("ignore_dirs", []))

    for row in rows:
        item_id = str(row["item_id"])
        user_id = str(row["user_id"] or "")
        title = str(row["title"] or item_id)
        item = get_item_from_jellyfin(config, item_id, user_id=user_id)

        if not item:
            continue

        path = item.get("Path")
        if not path:
            continue

        source_file = Path(path)

        if source_file.is_dir():
            source_file = find_largest_video_file(source_file, ignore_dirs, extensions)
            if source_file is None:
                continue

        if not is_video_file(source_file, extensions):
            continue

        library = find_matching_library(source_file, libraries)
        if not library:
            continue

        plays = int(row["plays"])
        if plays < library.promote_after_plays:
            continue

        try:
            size = source_file.stat().st_size
        except FileNotFoundError:
            continue

        candidates.append(
            Candidate(
                item_id=item_id,
                user_id=user_id,
                title=title,
                source_file=source_file,
                library=library,
                plays=plays,
                last_played=str(row["last_played"]),
                size_bytes=size,
                reason=f"{plays} plays in last {hot_window_days} days",
            )
        )

    return candidates


def _quote_sqlite_ident(identifier: str) -> str:
    """Quote a SQLite identifier."""
    return '"' + identifier.replace('"', '""') + '"'


def inspect_jellyfin_sqlite_schema(db_path: Path) -> dict[str, Any]:
    """
    Inspect a core Jellyfin SQLite database without modifying it.

    Jellyfin's core SQLite and PostgreSQL backends expose the same logical
    playback state through UserData and media paths through BaseItems. Keep
    this inspection strict so schema drift fails closed instead of silently
    producing an incomplete candidate set.
    """
    if not db_path.exists():
        raise RuntimeError(f"Jellyfin SQLite database not found: {db_path}")

    con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    try:
        tables = {
            str(row["name"]).lower(): str(row["name"])
            for row in con.execute(
                "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
            )
        }

        userdata_table = tables.get("userdata")
        baseitems_table = tables.get("baseitems")
        if not userdata_table or not baseitems_table:
            raise RuntimeError(
                "Jellyfin core SQLite schema requires UserData and BaseItems; "
                f"found tables: {sorted(tables.values())}"
            )

        def column_map(table_name: str) -> dict[str, str]:
            return {
                str(row["name"]).lower(): str(row["name"])
                for row in con.execute(
                    f"PRAGMA table_info({_quote_sqlite_ident(table_name)})"
                )
            }

        userdata_columns = column_map(userdata_table)
        baseitems_columns = column_map(baseitems_table)

        required_userdata = {"itemid", "userid", "playcount", "lastplayeddate"}
        required_baseitems = {"id", "path"}
        missing_userdata = sorted(required_userdata - set(userdata_columns))
        missing_baseitems = sorted(required_baseitems - set(baseitems_columns))

        if missing_userdata:
            raise RuntimeError(
                "Jellyfin SQLite UserData is missing columns: "
                + ", ".join(missing_userdata)
            )
        if missing_baseitems:
            raise RuntimeError(
                "Jellyfin SQLite BaseItems is missing columns: "
                + ", ".join(missing_baseitems)
            )

        return {
            "userdata_table": userdata_table,
            "baseitems_table": baseitems_table,
            "userdata_columns": userdata_columns,
            "baseitems_columns": baseitems_columns,
        }
    finally:
        con.close()


def query_jellyfin_sqlite(
    config: dict[str, Any],
    libraries: list[Library],
    extensions: set[str],
) -> list[Candidate]:
    """
    Read playback state from Jellyfin's core SQLite database.

    This mirrors the PostgreSQL UserData behavior: PlayCount is lifetime state,
    while LastPlayedDate must be inside the configured hot window. Duplicate
    CustomDataKey rows are collapsed to one state per item/user before play
    counts are summed across users.
    """
    playback = config.get("playback_reporting", {})
    db_path = Path(
        playback.get("database_path", "/var/lib/jellyfin/data/jellyfin.db")
    )
    schema = inspect_jellyfin_sqlite_schema(db_path)

    userdata_table = str(schema["userdata_table"])
    baseitems_table = str(schema["baseitems_table"])
    userdata_columns = dict(schema["userdata_columns"])
    baseitems_columns = dict(schema["baseitems_columns"])

    item_col = userdata_columns["itemid"]
    user_col = userdata_columns["userid"]
    play_count_col = userdata_columns["playcount"]
    last_played_col = userdata_columns["lastplayeddate"]
    base_id_col = baseitems_columns["id"]
    base_path_col = baseitems_columns["path"]
    base_name_col = baseitems_columns.get("name")

    q_userdata = _quote_sqlite_ident(userdata_table)
    q_baseitems = _quote_sqlite_ident(baseitems_table)
    q_item = _quote_sqlite_ident(item_col)
    q_user = _quote_sqlite_ident(user_col)
    q_play_count = _quote_sqlite_ident(play_count_col)
    q_last_played = _quote_sqlite_ident(last_played_col)
    q_base_id = _quote_sqlite_ident(base_id_col)
    q_base_path = _quote_sqlite_ident(base_path_col)
    q_base_name = _quote_sqlite_ident(base_name_col) if base_name_col else None

    hot_window_days = int(config["cache"].get("hot_window_days", 30))
    cutoff = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=hot_window_days)
    cutoff_min = cutoff.strftime("%Y-%m-%d")
    title_expr = f"MIN(CAST(bi.{q_base_name} AS TEXT))" if q_base_name else "MIN(pu.item_id)"

    sql = f"""
        WITH per_user AS (
            SELECT CAST(ud.{q_item} AS TEXT) AS item_id,
                   CAST(ud.{q_user} AS TEXT) AS user_id,
                   MAX(COALESCE(ud.{q_play_count}, 0)) AS plays,
                   MAX(ud.{q_last_played}) AS last_played
            FROM {q_userdata} ud
            WHERE ud.{q_last_played} >= ?
              AND COALESCE(ud.{q_play_count}, 0) > 0
            GROUP BY ud.{q_item}, ud.{q_user}
        )
        SELECT pu.item_id,
               MIN(pu.user_id) AS user_id,
               {title_expr} AS title,
               COALESCE(SUM(pu.plays), 0) AS plays,
               MAX(pu.last_played) AS last_played,
               MIN(CAST(bi.{q_base_path} AS TEXT)) AS path
        FROM per_user pu
        JOIN {q_baseitems} bi
          ON pu.item_id = CAST(bi.{q_base_id} AS TEXT)
        WHERE bi.{q_base_path} IS NOT NULL
          AND CAST(bi.{q_base_path} AS TEXT) <> ''
        GROUP BY pu.item_id
        HAVING COALESCE(SUM(pu.plays), 0) > 0
        ORDER BY plays DESC, last_played DESC
    """

    con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    try:
        rows = list(con.execute(sql, (cutoff_min,)))
    finally:
        con.close()

    candidates: list[Candidate] = []
    ignore_dirs = set(config.get("media_selection", {}).get("ignore_dirs", []))

    for row in rows:
        item_id = str(row["item_id"])
        user_id = str(row["user_id"] or "")
        title = str(row["title"] or item_id)
        path = str(row["path"] or "")
        if not path:
            continue

        source_file = Path(path)
        if source_file.is_dir():
            source_file = find_largest_video_file(source_file, ignore_dirs, extensions)
            if source_file is None:
                continue

        if not is_video_file(source_file, extensions):
            continue

        library = find_matching_library(source_file, libraries)
        if not library:
            continue

        plays = int(row["plays"])
        if plays < library.promote_after_plays:
            continue

        try:
            size = source_file.stat().st_size
        except FileNotFoundError:
            continue

        if title == item_id:
            title = source_file.stem

        candidates.append(
            Candidate(
                item_id=item_id,
                user_id=user_id,
                title=title,
                source_file=source_file,
                library=library,
                plays=plays,
                last_played=str(row["last_played"]),
                size_bytes=size,
                reason=f"{plays} lifetime plays; last played within {hot_window_days} days",
            )
        )

    return candidates


def _quote_pg_ident(identifier: str) -> str:
    """Quote a PostgreSQL identifier without requiring a live connection."""
    return '"' + identifier.replace('"', '""') + '"'


def _connect_postgresql(playback: dict[str, Any]):
    """
    Connect to PostgreSQL using psycopg v3 or psycopg2.

    Supported config forms:
      playback_reporting.postgresql.dsn: "dbname=jellyfin user=jellyfin ..."
    or:
      playback_reporting.postgresql.host
      playback_reporting.postgresql.port
      playback_reporting.postgresql.database
      playback_reporting.postgresql.user
      playback_reporting.postgresql.password
      playback_reporting.postgresql.password_env
      playback_reporting.postgresql.sslmode
    """
    pg_cfg = playback.get("postgresql", {}) or {}

    password = pg_cfg.get("password")
    password_env = pg_cfg.get("password_env")
    if not password and password_env:
        password = os.environ.get(str(password_env), "")

    dsn = pg_cfg.get("dsn")

    try:
        import psycopg  # type: ignore

        if dsn:
            return psycopg.connect(str(dsn)), "psycopg3"

        kwargs = {
            "host": pg_cfg.get("host", "localhost"),
            "port": int(pg_cfg.get("port", 5432)),
            "dbname": pg_cfg.get("database", pg_cfg.get("dbname", "jellyfin")),
            "user": pg_cfg.get("user", "jellyfin"),
        }
        if password:
            kwargs["password"] = password
        if pg_cfg.get("sslmode"):
            kwargs["sslmode"] = pg_cfg.get("sslmode")
        return psycopg.connect(**kwargs), "psycopg3"
    except ImportError:
        pass

    try:
        import psycopg2  # type: ignore

        if dsn:
            return psycopg2.connect(str(dsn)), "psycopg2"

        kwargs = {
            "host": pg_cfg.get("host", "localhost"),
            "port": int(pg_cfg.get("port", 5432)),
            "dbname": pg_cfg.get("database", pg_cfg.get("dbname", "jellyfin")),
            "user": pg_cfg.get("user", "jellyfin"),
        }
        if password:
            kwargs["password"] = password
        if pg_cfg.get("sslmode"):
            kwargs["sslmode"] = pg_cfg.get("sslmode")
        return psycopg2.connect(**kwargs), "psycopg2"
    except ImportError as exc:
        raise RuntimeError(
            "PostgreSQL playback_reporting.source requires python3-psycopg "
            "or python3-psycopg2. Install one, for example: "
            "sudo apt install python3-psycopg2"
        ) from exc


def query_playback_reporting_postgresql(
    config: dict[str, Any],
    libraries: list[Library],
    extensions: set[str],
) -> list[Candidate]:
    """
    Read playback history from PostgreSQL.

    For PostgreSQL-backed Jellyfin, prefer the core Jellyfin public.UserData
    table. The Playback Reporting plugin may be unsupported or absent under
    PostgreSQL, and ActivityLogs are not reliable playback history. UserData
    provides lifetime PlayCount plus LastPlayedDate, so the window means
    "last played inside the hot window", not "N plays inside the hot window".

    ItemId values are still resolved through the Jellyfin API so the script can
    use Jellyfin's media path rather than trying to reconstruct paths from SQL.
    """
    playback = config.get("playback_reporting", {})
    hot_window_days = int(config["cache"].get("hot_window_days", 30))
    cutoff = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=hot_window_days)

    conn, _driver = _connect_postgresql(playback)

    def get_columns(cur: Any, schema: str, table_name: str) -> list[str]:
        cur.execute(
            """
            SELECT column_name
            FROM information_schema.columns
            WHERE table_schema = %s AND table_name = %s
            ORDER BY ordinal_position
            """,
            (schema, table_name),
        )
        return [str(r[0]) for r in cur.fetchall()]

    try:
        cur = conn.cursor()

        cur.execute(
            """
            SELECT table_schema, table_name
            FROM information_schema.tables
            WHERE table_type = 'BASE TABLE'
              AND table_schema NOT IN ('pg_catalog', 'information_schema')
            ORDER BY table_schema, table_name
            """
        )
        tables = [(str(r[0]), str(r[1])) for r in cur.fetchall()]
        table_lookup = {(schema.lower(), name.lower()): (schema, name) for schema, name in tables}

        table: Optional[tuple[str, str]] = None
        cols: list[str] = []
        history_mode = "event_rows"

        # PostgreSQL Jellyfin core history. Prefer this over ActivityLogs; the
        # latter can contain plugin/admin messages with ItemId values that are
        # not actual playback events.
        userdata_table = table_lookup.get(("public", "userdata"))
        if userdata_table:
            userdata_cols = get_columns(cur, userdata_table[0], userdata_table[1])
            userdata_lower = {c.lower() for c in userdata_cols}
            if {"itemid", "userid", "playcount", "lastplayeddate"}.issubset(userdata_lower):
                table = userdata_table
                cols = userdata_cols
                history_mode = "jellyfin_userdata"

        # Fallback for any future/legacy PostgreSQL Playback Reporting table.
        # Intentionally do NOT include ActivityLogs here; ActivityLogs are not
        # playback history and caused false candidates such as plugin messages.
        if table is None:
            preferred_tables = [
                "PlaybackActivity",
                "PlaybackActivityEntry",
                "PlaybackReport",
                "PlaybackReports",
                "PlaybackReporting",
            ]
            preferred_lower = {t.lower() for t in preferred_tables}
            for schema, name in tables:
                if name.lower() not in preferred_lower:
                    continue
                candidate_cols = get_columns(cur, schema, name)
                lower = {c.lower() for c in candidate_cols}
                if ("itemid" in lower or "item_id" in lower) and any(
                    c in lower for c in ["datecreated", "created", "playbackdate", "lastplayeddate", "date", "timestamp"]
                ):
                    table = (schema, name)
                    cols = candidate_cols
                    history_mode = "event_rows"
                    break

        if table is None:
            found = [f"{schema}.{name}" for schema, name in tables]
            raise RuntimeError(
                "Could not identify a supported PostgreSQL playback history source. "
                "Expected public.UserData or a Playback Reporting event table. "
                "Refusing to use ActivityLogs because they are not playback history. "
                f"Found tables: {found}"
            )

        schema, table_name = table
        lower_map = {c.lower(): c for c in cols}

        item_col = lower_map.get("itemid") or lower_map.get("item_id")
        name_col = (
            lower_map.get("itemname")
            or lower_map.get("name")
            or lower_map.get("item_name")
            or lower_map.get("title")
        )

        date_candidates = [
            "lastplayeddate" if history_mode == "jellyfin_userdata" else "datecreated",
            "datecreated",
            "created",
            "playbackdate",
            "lastplayeddate",
            "date",
            "timestamp",
        ]
        date_col = next((lower_map[c] for c in date_candidates if c in lower_map), None)

        if not item_col:
            raise RuntimeError(f"Could not find ItemId column in table {schema}.{table_name}")
        if not date_col:
            raise RuntimeError(f"Could not find date column in table {schema}.{table_name}")

        user_col = lower_map.get("userid") or lower_map.get("user_id")
        play_count_col = (
            lower_map.get("playcount")
            or lower_map.get("play_count")
            or lower_map.get("plays")
        )

        q_schema = _quote_pg_ident(schema)
        q_table = _quote_pg_ident(table_name)
        q_item = _quote_pg_ident(item_col)
        q_date = _quote_pg_ident(date_col)

        if history_mode == "jellyfin_userdata":
            # PostgreSQL-backed Jellyfin can throw "Cannot deserialize unknown type"
            # when /Items is called through the API on certain migrated rows.
            # Avoid that API path by joining UserData directly to BaseItems and
            # reading the media Path/Name from PostgreSQL. /Sessions is still
            # used separately only to avoid touching actively streaming files.
            if not play_count_col:
                raise RuntimeError(f"Could not find PlayCount column in table {schema}.{table_name}")

            baseitems_table = table_lookup.get(("public", "baseitems"))
            if not baseitems_table:
                raise RuntimeError("Could not find public.BaseItems needed to resolve UserData ItemId paths")

            base_cols = get_columns(cur, baseitems_table[0], baseitems_table[1])
            base_lower = {c.lower(): c for c in base_cols}
            base_id_col = base_lower.get("id")
            base_path_col = base_lower.get("path")
            base_name_col = base_lower.get("name")

            if not base_id_col or not base_path_col:
                raise RuntimeError(
                    "Could not find Id/Path columns in public.BaseItems needed to resolve media paths"
                )

            q_ud_schema = q_schema
            q_ud_table = q_table
            q_base_schema = _quote_pg_ident(baseitems_table[0])
            q_base_table = _quote_pg_ident(baseitems_table[1])
            q_user = _quote_pg_ident(user_col) if user_col else None
            q_play_count = _quote_pg_ident(play_count_col)
            q_base_id = _quote_pg_ident(base_id_col)
            q_base_path = _quote_pg_ident(base_path_col)
            q_base_name = _quote_pg_ident(base_name_col) if base_name_col else None

            if not q_user:
                raise RuntimeError(f"Could not find UserId column in table {schema}.{table_name}")

            title_expr = f"MIN(bi.{q_base_name}::text)" if q_base_name else "MIN(pu.item_id)"

            # UserData may contain several rows for the same item/user under
            # different CustomDataKey values (for example provider IDs). Those
            # rows mirror the same play state and must not be summed as separate
            # plays. Collapse to one row per item/user with MAX(PlayCount), then
            # sum across users for the household-level promotion threshold.
            sql = f"""
                WITH per_user AS (
                    SELECT ud.{q_item}::text AS item_id,
                           ud.{q_user}::text AS user_id,
                           MAX(COALESCE(ud.{q_play_count}, 0)) AS plays,
                           MAX(ud.{q_date}) AS last_played
                    FROM {q_ud_schema}.{q_ud_table} ud
                    WHERE ud.{q_date} >= %s
                      AND COALESCE(ud.{q_play_count}, 0) > 0
                    GROUP BY ud.{q_item}, ud.{q_user}
                )
                SELECT pu.item_id,
                       MIN(pu.user_id) AS user_id,
                       {title_expr} AS title,
                       COALESCE(SUM(pu.plays), 0) AS plays,
                       MAX(pu.last_played) AS last_played,
                       MIN(bi.{q_base_path}::text) AS path
                FROM per_user pu
                JOIN {q_base_schema}.{q_base_table} bi
                  ON pu.item_id = bi.{q_base_id}::text
                WHERE bi.{q_base_path} IS NOT NULL
                  AND bi.{q_base_path}::text <> ''
                GROUP BY pu.item_id
                HAVING COALESCE(SUM(pu.plays), 0) > 0
                ORDER BY plays DESC, last_played DESC
            """
        else:
            user_expr = f"MIN({_quote_pg_ident(user_col)}::text)" if user_col else "NULL"
            title_expr = (
                f"MIN({_quote_pg_ident(name_col)}::text)"
                if name_col
                else f"MIN({q_item}::text)"
            )
            plays_expr = "COUNT(*)"
            where_expr = f"{q_date} >= %s"

            sql = f"""
                SELECT MIN({q_item}::text) AS item_id,
                       {user_expr} AS user_id,
                       {title_expr} AS title,
                       {plays_expr} AS plays,
                       MAX({q_date}) AS last_played,
                       NULL AS path
                FROM {q_schema}.{q_table}
                WHERE {where_expr}
                GROUP BY {q_item}
                HAVING {plays_expr} > 0
                ORDER BY plays DESC, last_played DESC
            """

        cur.execute(sql, (cutoff,))
        rows = cur.fetchall()
    finally:
        conn.close()

    candidates: list[Candidate] = []
    ignore_dirs = set(config.get("media_selection", {}).get("ignore_dirs", []))

    for row in rows:
        item_id = str(row[0])
        user_id = str(row[1] or "")
        title = str(row[2] or item_id)
        db_path = str(row[5] or "") if len(row) > 5 else ""

        item: Optional[dict[str, Any]] = None
        path = db_path

        # Event-row Playback Reporting fallback may not include paths. In that
        # case, and only in that case, resolve through the Jellyfin API. The
        # normal PostgreSQL UserData path avoids /Items because migrated
        # PostgreSQL installs can fail that endpoint with
        # "Cannot deserialize unknown type."
        if not path:
            item = get_item_from_jellyfin(config, item_id, user_id=user_id)
            if not item:
                continue
            path = str(item.get("Path") or "")

        if not path:
            continue

        source_file = Path(path)

        if source_file.is_dir():
            source_file = find_largest_video_file(source_file, ignore_dirs, extensions)
            if source_file is None:
                continue

        if not is_video_file(source_file, extensions):
            continue

        library = find_matching_library(source_file, libraries)
        if not library:
            continue

        plays = int(row[3])
        if plays < library.promote_after_plays:
            continue

        try:
            size = source_file.stat().st_size
        except FileNotFoundError:
            continue

        api_title = str(item.get("Name") or "").strip() if item else ""
        if api_title:
            title = api_title
        elif title == item_id:
            title = source_file.stem

        if history_mode == "jellyfin_userdata":
            reason = f"{plays} lifetime plays; last played within {hot_window_days} days"
        else:
            reason = f"{plays} playback events in last {hot_window_days} days"

        candidates.append(
            Candidate(
                item_id=item_id,
                user_id=user_id,
                title=title,
                source_file=source_file,
                library=library,
                plays=plays,
                last_played=str(row[4]),
                size_bytes=size,
                reason=reason,
            )
        )

    return candidates

def discover_recent_candidates_fallback(
    config: dict[str, Any],
    libraries: list[Library],
    extensions: set[str],
) -> list[Candidate]:
    # Intentionally conservative: do not use filesystem atime, because atime is
