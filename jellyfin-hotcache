#!/usr/bin/env python3
"""
jellyfin-hotcache.py

External Jellyfin hot-cache manager.

Promotes frequently watched Jellyfin media files from slower NAS storage to an
SSD cache while preserving the original Jellyfin-visible path with an absolute
symlink.

Default behavior:
  - File-level caching only.
  - Whole-directory promotion is disabled.
  - Dry-run is enabled in the sample config.
  - Email reporting is supported through local sendmail/postfix.
"""

